{
  "name": "fashnlink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web-app dev",
    "dev:mobile": "pnpm --filter mobile-app start",
    "build": "pnpm --filter web-app build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm --filter web-app test",
    "format": "pnpm -r --if-present run format",
    "format:check": "pnpm -r --if-present run format:check",
    "db:up": "pnpm --filter web-app db:up",
    "db:down": "pnpm --filter web-app db:down",
    "db:migrate": "pnpm --filter web-app db:migrate"
  },
  "packageManager": "pnpm@11.18.0"
}
