# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000            # public base URL, used for share links and OG images
APP_SECRET=                                          # 32+ random bytes, signs shopper cookies and link tokens
NODE_ENV=development
TUNNEL_URL=                                          # optional; overrides NEXT_PUBLIC_APP_URL for fal webhooks + OG image URLs when developing behind ngrok/a tunnel (unreachable from localhost otherwise)

# ---------- Database (Neon in prod, docker-compose Postgres in dev) ----------
DATABASE_URL=                                        # postgres connection string (pooled); local dev: postgresql://user:password@localhost:5437/app_dev (see docker-compose.yml)
DATABASE_URL_UNPOOLED=                               # direct connection for migrations; same value as above in local dev

# ---------- Auth (Better Auth) ----------
BETTER_AUTH_SECRET=                                  # random 32+ bytes
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=                                    # optional in dev; magic link works without it
GOOGLE_CLIENT_SECRET=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="App <hello@yourdomain.com>"

# ---------- Storage (UploadThing) ----------
UPLOADTHING_TOKEN=                                   # dashboard → API Keys; encodes app id, region, and the API key

# ---------- Models ----------
FAL_KEY=                                             # fal.ai API key
FAL_WEBHOOK_SECRET=                                  # random string appended to webhook URL, verified on receipt
OPENAI_API_KEY=                                      # classification + moderation
TYPESAFE_API_KEY=                                    # TypeSafe AI console -> API keys; calls the Jev decision model directly (fast/cheap text classification before the OpenAI vision call)

# ---------- Payments (Polar) ----------
POLAR_ACCESS_TOKEN=                                  # organization access token, dashboard -> Settings -> Developers
POLAR_WEBHOOK_SECRET=                                # webhook signing secret, dashboard -> Settings -> Webhooks
POLAR_FOUNDING_PASS_PRODUCT_ID=                      # product id, checkout sessions are created via PayKit (lib/paykit.ts), not a static dashboard link

# ---------- Encryption ----------
ENCRYPTION_KEY=                                      # 32 bytes base64, encrypts merchant ESP API keys at rest (AES-256-GCM)

# ---------- Redis (Upstash in prod, docker-compose in dev) ----------
UPSTASH_REDIS_REST_URL=                              # prod: real Upstash REST URL; local dev: http://localhost:8079 (the redis-http proxy in docker-compose.yml)
UPSTASH_REDIS_REST_TOKEN=                            # prod: real Upstash token; local dev: matches SRH_TOKEN in docker-compose.yml

# ---------- Jobs ----------
CRON_SECRET=                                         # Vercel cron auth header value

# ---------- Optional / Phase 2 ----------
SCRAPER_WORKER_URL=                                  # Playwright worker base URL, empty = browser fallback disabled
SCRAPER_WORKER_SECRET=
SCRAPER_PROXY_URL=                                   # http(s)://user:pass@host:port for browser path only
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
