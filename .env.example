# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000            # public base URL, used for share links and OG images
APP_SECRET=                                          # 32+ random bytes, signs shopper cookies and link tokens
NODE_ENV=development

# ---------- Database (Neon) ----------
DATABASE_URL=                                        # postgres connection string (pooled)
DATABASE_URL_UNPOOLED=                               # direct connection for migrations

# ---------- Auth (Better Auth) ----------
BETTER_AUTH_SECRET=                                  # random 32+ bytes
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=                                    # optional in dev; magic link works without it
GOOGLE_CLIENT_SECRET=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="App <hello@yourdomain.com>"

# ---------- Storage (Cloudflare R2) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=app
R2_PUBLIC_BASE_URL=                                  # public bucket/custom domain, e.g. https://img.yourdomain.com

# ---------- Models ----------
FAL_KEY=                                             # fal.ai API key
FAL_WEBHOOK_SECRET=                                  # random string appended to webhook URL, verified on receipt
OPENAI_API_KEY=                                      # classification + moderation

# ---------- Payments (Stripe) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_PASS_PAYMENT_LINK=                   # https://buy.stripe.com/... created in dashboard
STRIPE_FOUNDING_PASS_PRICE_ID=                       # price_... used to match webhook

# ---------- Encryption ----------
ENCRYPTION_KEY=                                      # 32 bytes base64, encrypts merchant ESP API keys at rest (AES-256-GCM)

# ---------- Redis (Upstash) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Jobs ----------
CRON_SECRET=                                         # Vercel cron auth header value

# ---------- Optional / Phase 2 ----------
SCRAPER_WORKER_URL=                                  # Playwright worker base URL, empty = browser fallback disabled
SCRAPER_WORKER_SECRET=
SCRAPER_PROXY_URL=                                   # http(s)://user:pass@host:port for browser path only
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
